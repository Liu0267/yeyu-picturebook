# Copy values into your shell environment. The app does not auto-load dotenv.
YU_DATA_DIR=./data
YU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: compile scripts/vision_ocr.swift locally and set its absolute path.
# YU_VISION_EXECUTABLE=/absolute/path/to/vision_ocr
# Optional local MLX runtime; separate from the API virtual environment.
# YU_MODEL_PYTHON=/absolute/path/to/model-env/bin/python
# YU_VLM_MODEL_DIR=/absolute/path/to/Qwen3-VL-4B-Instruct-4bit
# YU_TTS_MODEL_DIR=/absolute/path/to/Qwen3-TTS-1.7B-CustomVoice-4bit
# YU_VIDEO_PROVIDER=agnes
# Local Apple Silicon alternative (separate native runtime; no book upload):
# YU_VIDEO_PROVIDER=wan_local
# YU_WAN_EXECUTABLE=/absolute/path/to/stable-diffusion.cpp/build/bin/sd-cli
# YU_WAN_MODEL_DIR=/absolute/path/to/Wan2.2-TI2V-5B-GGUF
# YU_AGNES_MODEL=agnes-video-2.5-flash
# AGNES_API_KEY is read from the process environment, or use a private file:
# YU_AGNES_KEY_FILE=/private/config/agnes.key
# The macOS launcher additionally reads .local/runtime.env when present.
