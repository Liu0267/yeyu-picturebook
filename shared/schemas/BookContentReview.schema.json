{
  "$defs": {
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_ref_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ref Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "name",
        "description",
        "source_ref_ids"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "description",
        "fact_ids"
      ],
      "title": "Event",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text_explicit",
            "visual_observation",
            "inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_ref_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ref Ids",
          "type": "array"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        }
      },
      "required": [
        "fact_id",
        "page_id",
        "claim",
        "kind",
        "source_ref_ids"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "properties": {
        "x1": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Y2",
          "type": "number"
        }
      },
      "title": "Region",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "original_text",
            "original_image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "page_id",
        "kind",
        "locator",
        "region"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "reviewed_page_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reviewed Page Ids",
      "type": "array"
    }
  },
  "required": [
    "expected_revision",
    "reviewer",
    "source_refs",
    "facts",
    "entities",
    "events"
  ],
  "title": "BookContentReview",
  "type": "object"
}