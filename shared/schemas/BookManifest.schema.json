{
  "$defs": {
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_ref_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ref Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "name",
        "description",
        "source_ref_ids"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "description",
        "fact_ids"
      ],
      "title": "Event",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text_explicit",
            "visual_observation",
            "inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_ref_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ref Ids",
          "type": "array"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        }
      },
      "required": [
        "fact_id",
        "page_id",
        "claim",
        "kind",
        "source_ref_ids"
      ],
      "title": "Fact",
      "type": "object"
    },
    "OCRLine": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "raw_text": {
          "title": "Raw Text",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "suggested_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Text"
        },
        "confirmed_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed Text"
        }
      },
      "required": [
        "line_id",
        "raw_text",
        "region"
      ],
      "title": "OCRLine",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "printed_page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Printed Page"
        },
        "page_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Page Revision",
          "type": "integer"
        },
        "image_asset_id": {
          "title": "Image Asset Id",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "source_locator": {
          "title": "Source Locator",
          "type": "string"
        },
        "ocr_engine": {
          "title": "Ocr Engine",
          "type": "string"
        },
        "ocr_lines": {
          "items": {
            "$ref": "#/$defs/OCRLine"
          },
          "title": "Ocr Lines",
          "type": "array"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "review_status": {
          "default": "needs_review",
          "enum": [
            "needs_review",
            "reviewed"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "sequence",
        "image_asset_id",
        "width",
        "height",
        "source_locator",
        "ocr_engine"
      ],
      "title": "Page",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "properties": {
        "x1": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Y2",
          "type": "number"
        }
      },
      "title": "Region",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "original_text",
            "original_image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "page_id",
        "kind",
        "locator",
        "region"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "book_id": {
      "title": "Book Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "is_mock": {
      "default": false,
      "title": "Is Mock",
      "type": "boolean"
    },
    "rights_status": {
      "default": "user_supplied_local_research",
      "title": "Rights Status",
      "type": "string"
    },
    "external_upload_allowed": {
      "default": false,
      "title": "External Upload Allowed",
      "type": "boolean"
    },
    "source_filename": {
      "title": "Source Filename",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "book_id",
    "title",
    "source_filename",
    "source_sha256",
    "pages"
  ],
  "title": "BookManifest",
  "type": "object"
}