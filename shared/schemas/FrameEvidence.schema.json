      "type": "string"
    },
    "clip_id": {
      "title": "Clip Id",
      "type": "string"
    },
    "asset_version": {
      "minimum": 1,
      "title": "Asset Version",
      "type": "integer"
    },
    "t_ms": {
      "minimum": 0,
      "title": "T Ms",
      "type": "integer"
    },
    "image_asset_id": {
      "title": "Image Asset Id",
      "type": "string"
    },
    "video_sha256": {
      "title": "Video Sha256",
      "type": "string"
