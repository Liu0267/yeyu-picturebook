          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
